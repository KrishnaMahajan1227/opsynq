PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/OPSYNQ?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Bootstrap the first Platform Superadmin, then run: npm --workspace services/api run seed:platform
PLATFORM_SUPERADMIN_NAME=Opsynq Platform Superadmin
PLATFORM_SUPERADMIN_EMAIL=
PLATFORM_SUPERADMIN_MOBILE=
PLATFORM_SUPERADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Security hardening
AGENCY_JWT_EXPIRES_IN=24h
TRUST_PROXY=0
PUBLIC_APP_URL=http://localhost:5173

# Email password recovery. Local development may use console.
# Production must use: EMAIL_PROVIDER=resend + RESEND_API_KEY + EMAIL_FROM.
EMAIL_PROVIDER=console
EMAIL_FROM=Opsynq Security <security@your-domain.com>
RESEND_API_KEY=

