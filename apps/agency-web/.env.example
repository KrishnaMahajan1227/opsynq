# Local API. In production leave VITE_API_URL empty to use the same HTTPS origin.
VITE_API_URL=http://localhost:3000

# Optional: only enable when Socket.IO is hosted on a persistent Node/WebSocket server.
# Vercel/serverless should keep this false; location uses REST heartbeat + polling.
VITE_SOCKET_SERVER_URL=http://localhost:3000
VITE_ENABLE_SOCKET_REALTIME=false

# Optional Google reverse-geocoding support used by location presence labels.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
