    "qa:contracts": "node scripts/module-contracts.js",
    "qa:routes": "node scripts/route-contracts.js",
    "qa:release": "npm run qa:source && npm run qa:routes && node scripts/release-gate.js",
    "smoke:local": "node scripts/verify-local.js",
    "production:start": "cd services/api && node server.js",
    "qa:effects": "node scripts/effect-contracts.js",
    "qa:permissions": "node scripts/permission-contracts.js",
    "qa:jsx": "node scripts/jsx-syntax.js",
    "uat:contracts": "node scripts/uat-contracts.js",
    "uat:local": "node scripts/uat-local.js",
    "uat:release": "npm run qa:release && npm run uat:contracts",
    "qa:build": "npm run build:all",
    "seed:demo": "cd services/api && node seed/demoData.js",
    "seed:full-demo": "npm run seed && npm run seed:demo",
    "verify:demo": "node scripts/verify-demo.js",
    "qa:roles": "node scripts/role-navigation-contracts.js",
    "qa:phase24": "node scripts/phase24-contracts.js",
    "qa:phase26": "node scripts/phase26-contracts.js",
    "qa:phase28": "node scripts/phase28-contracts.js",
    "production:watch": "cd services/api && node --watch-preserve-output server.js",
    "qa:phase29": "node scripts/phase29-contracts.js",
    "qa:phase31": "node scripts/phase31-contracts.js",
    "qa:phase31-hotfix": "node scripts/phase31-hotfix-contracts.js",
    "qa:phase32": "node scripts/phase32-functional-contracts.js",
    "qa:phase33": "node scripts/phase33-contracts.js",
    "qa:phase34": "node scripts/phase34-security-contracts.js",
    "qa:phase35": "node scripts/phase35-hierarchy-contracts.js",
    "build": "npm run build:all",
    "start": "node server.js",
    "vercel-build": "npm run build",
    "qa:phase36": "node scripts/phase36-ux-contracts.js",
    "qa:phase37": "node scripts/phase37-scale-ux-contracts.js",
    "qa:phase38": "node scripts/phase38-data-flow-contracts.js",
    "qa:phase39": "node scripts/phase39-supply-chain-contracts.js",
    "qa:phase40": "node scripts/phase40-professional-ux-contracts.js",
    "qa:phase41": "node scripts/phase41-ai-agency-contracts.js"
